#!/usr/bin/env python
from __future__ import annotations

import subprocess
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parent
PYTHON = ROOT / ".venv" / ("Scripts/python.exe" if sys.platform == "win32" else "bin/python")

if not PYTHON.exists():
    raise SystemExit("ai-doc runtime is missing. Run: python tools/bootstrap.py")

raise SystemExit(subprocess.call([str(PYTHON), "-m", "ai_doc", *sys.argv[1:]], shell=False))
